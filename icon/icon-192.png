<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <!-- Arka plan -->
  <rect width="192" height="192" rx="36" fill="#4A90E2"/>
  
  <!-- Not defteri gövdesi -->
  <rect x="45" y="38" width="90" height="120" rx="6" fill="#FFFFFF" stroke="#2C3E50" stroke-width="4"/>
  
  <!-- Spiraller (sol taraf) -->
  <g fill="none" stroke="#2C3E50" stroke-width="4" stroke-linecap="round">
    <line x1="45" y1="56" x2="34" y2="56"/>
    <line x1="45" y1="75" x2="34" y2="75"/>
    <line x1="45" y1="94" x2="34" y2="94"/>
    <line x1="45" y1="113" x2="34" y2="113"/>
    <line x1="45" y1="132" x2="34" y2="132"/>
  </g>
  
  <!-- Defter çizgileri -->
  <g stroke="#BDC3C7" stroke-width="2.5" stroke-linecap="round">
    <line x1="60" y1="68" x2="124" y2="68"/>
    <line x1="60" y1="86" x2="124" y2="86"/>
    <line x1="60" y1="104" x2="124" y2="104"/>
    <line x1="60" y1="122" x2="105" y2="122"/>
  </g>
  
  <!-- Kalem -->
  <g transform="rotate(35 131 131)">
    <rect x="124" y="45" width="15" height="105" fill="#F5A623" stroke="#2C3E50" stroke-width="3"/>
    <polygon points="124,150 139,150 131.5,168" fill="#E8D5B7" stroke="#2C3E50" stroke-width="3" stroke-linejoin="round"/>
    <polygon points="129,163 134,163 131.5,168" fill="#2C3E50"/>
    <rect x="124" y="45" width="15" height="11" fill="#E74C3C" stroke="#2C3E50" stroke-width="3"/>
  </g>
</svg>